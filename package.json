{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node --env-file=.env.local scripts/migrate-neon.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/rsvp-db.int.test.ts",
    "test:vitrina-db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/vitrina",
    "test:e2e": "playwright test",
    "test:e2e:rsvp": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test e2e/rsvp.spec.ts",
    "test:e2e:vitrina": "PORT=3100 NEXT_PUBLIC_SITE_URL=http://localhost:3100 node --env-file=.env.local ./node_modules/@playwright/test/cli.js test e2e/vitrina.spec.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.8",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.5",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
