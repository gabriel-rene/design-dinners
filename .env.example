# Neon — pooled connection string from the Neon dashboard or Vercel integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Supabase Auth + Storage. The content tables live in Neon.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
# Site URL used in magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp group invite link — the landing's main CTA (falls back to "#" when unset)
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/replace-with-invite-code
